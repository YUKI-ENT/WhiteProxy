<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <EmbeddedResource Include="Defaults/WindowsUpdate.services.json" LogicalName="WhiteProxy.Defaults.WindowsUpdate.services.json" />
    <EmbeddedResource Include="WebAssets/*" LogicalName="WhiteProxy.Web.%(Filename)%(Extension)" />
    <ProjectReference Include="..\WhiteProxy.Proxy\WhiteProxy.Proxy.csproj" />
    <ProjectReference Include="..\WhiteProxy.Shared\WhiteProxy.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.14" />
    <PackageReference Include="System.Diagnostics.EventLog" Version="10.0.14" />
    <PackageReference Include="Titanium.Web.Proxy" Version="7.0.27" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
